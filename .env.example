NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000

# Genera una contraseña hash con:
# node scripts/generate-admin-hash.js "TuContraseñaSeguraDe12+"
ADMIN_PASSWORD_HASH=
# En producción debe ser una cadena aleatoria larga. Ejemplo de generación:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- SYSCOM ----------
SYSCOM_CLIENT_ID=
SYSCOM_CLIENT_SECRET=

# ---------- CT INTERNACIONAL ----------
CTONLINE_USER=
CTONLINE_PASSWORD=
CTONLINE_CLIENT_ID=

# ---------- TVC EN LINEA ----------
TVC_USER=
TVC_PASSWORD=
TVC_ACCOUNT=

# ---------- MERCADO LIBRE ----------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/mercadolibre/callback
ML_SITE_ID=MLM

# ---------- REGLAS DE PRECIO ----------
DEFAULT_MARKUP_PERCENT=25

# ---------- MERCADO PAGO ----------
MP_ACCESS_TOKEN=
# Se obtiene en Mercado Pago > Tus integraciones > Webhooks > Configurar notificaciones
